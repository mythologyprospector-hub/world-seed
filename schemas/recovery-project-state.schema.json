{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mythologyprospector-hub/world-seed/blob/feat/durable-terminal-journal/schemas/recovery-project-state.schema.json",
  "title": "Recoverable Project State",
  "description": "Versioned, provenance-aware project state for resuming work without treating summaries as independent evidence or authorization.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project",
    "record",
    "canon",
    "verification",
    "decisions",
    "current_work",
    "next_action",
    "retrieval"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "repository_url",
        "purpose"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "repository_url": {
          "type": "string",
          "format": "uri"
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "scope_notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_id",
        "updated_at",
        "updated_by",
        "describes_commit",
        "freshness",
        "provenance"
      ],
      "properties": {
        "record_id": {
          "type": "string",
          "minLength": 1
        },
        "updated_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "updated_by": {
          "type": "string",
          "minLength": 1
        },
        "describes_commit": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(?:[0-9a-f]{40}|unknown)$"
        },
        "freshness": {
          "enum": [
            "current",
            "possibly_stale",
            "unknown"
          ]
        },
        "provenance": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "mismatches": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "canon": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "authoritative_documents",
        "non_negotiable_rules",
        "reference_only"
      ],
      "properties": {
        "summary": {
          "type": "string"
        },
        "authoritative_documents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/documentRef"
          }
        },
        "non_negotiable_rules": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reference_only": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "verification": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim",
          "commit",
          "method",
          "result",
          "checked_at",
          "evidence",
          "scope_limitations"
        ],
        "properties": {
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "commit": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^(?:[0-9a-f]{40}|unknown)$"
          },
          "method": {
            "type": "string",
            "minLength": 1
          },
          "result": {
            "enum": [
              "pass",
              "fail",
              "not_run",
              "unknown"
            ]
          },
          "checked_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "scope_limitations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "decisions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accepted",
        "rejected",
        "open",
        "superseded"
      ],
      "properties": {
        "accepted": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/decision"
          }
        },
        "rejected": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/decision"
          }
        },
        "open": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/decision"
          }
        },
        "superseded": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/decision"
          }
        }
      }
    },
    "current_work": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "completed",
        "in_progress",
        "risks_and_blockers",
        "protect_do_not_disturb",
        "deferred"
      ],
      "properties": {
        "completed": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/workItem"
          }
        },
        "in_progress": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/workItem"
          }
        },
        "risks_and_blockers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "protect_do_not_disturb": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "deferred": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "next_action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "rationale",
        "preconditions",
        "expected_result",
        "authorization"
      ],
      "properties": {
        "action": {
          "type": "string",
          "minLength": 1
        },
        "rationale": {
          "type": "string"
        },
        "preconditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "expected_result": {
          "type": "string"
        },
        "authorization": {
          "enum": [
            "safe_with_existing_authority",
            "requires_human_approval",
            "unknown"
          ]
        }
      }
    },
    "retrieval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state_location",
        "evidence_locations",
        "instructions",
        "on_failure"
      ],
      "properties": {
        "state_location": {
          "type": "string"
        },
        "evidence_locations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "instructions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "on_failure": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "documentRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "location",
        "authority"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "location": {
          "type": "string",
          "minLength": 1
        },
        "authority": {
          "enum": [
            "canonical",
            "supporting",
            "implementation",
            "evidence"
          ]
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "statement",
        "status",
        "provenance",
        "scope",
        "evidence"
      ],
      "properties": {
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "explicitly_accepted",
            "explicitly_rejected",
            "undecided",
            "superseded"
          ]
        },
        "provenance": {
          "type": "string"
        },
        "scope": {
          "type": "string"
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "workItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item",
        "status",
        "location",
        "evidence"
      ],
      "properties": {
        "item": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string"
        },
        "location": {
          "type": "string"
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
